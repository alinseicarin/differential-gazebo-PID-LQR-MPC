# ROS 2/colcon generated artifacts. These directories are reproducible from src
# and can contain machine-specific absolute paths, so they are not versioned.
build/
install/
log/

# Raw benchmark outputs are reproducible experiment artifacts. Keep them in the
# mounted workspace so they survive container replacement, but do not mix them
# with controller source or checkpoint commits.
results/
robot_actual_trajectory.csv
robot_ground_truth_trajectory.csv
command_disturbance_actual_commands.csv

# Python bytecode and interpreter cache directories generated by launch files
# and helper scripts.
__pycache__/
*.py[cod]

# Test, coverage, type-checker, and linter caches are regenerated locally.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
*.egg-info/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Optional CMake tooling output generated from the local build tree.
compile_commands.json

# Local environment files may contain credentials or host-specific settings.
# Keep a deliberately sanitized .env.example if one is introduced later.
.env
.env.*
!.env.example

# Editor and operating-system metadata unrelated to the robotics experiment.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*:Zone.Identifier

# Local coding-agent state is host/session-specific and is not part of the
# reproducible ROS 2 workspace.
.agents/
.codex/

# Thesis drafts, writing guidelines, course papers, and other local reference
# material are kept outside version control. They may contain copyrighted or
# institution-specific documents and are not required to build the software.
docs/
materiale_lqr/
