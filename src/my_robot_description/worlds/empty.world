<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Nominal benchmark world: lighting and an infinite flat ground plane only. -->
  <world name="default_empty_world">
    <!-- Freeze the numerical physics settings used by every formal trial. -->
    <physics name="benchmark_ode" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <!-- Directional light used by the Gazebo client renderer. -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Standard static plane at z=0; all nominal paths lie on this surface. -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
  </world>
</sdf>
