<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Robustness world with deterministic bumps along the positive X direction. -->
  <world name="rough_world">
    <!-- Match the nominal-world solver for non-formal diagnostic use. -->
    <physics name="benchmark_ode" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Each obstacle is a static collision box. Small roll/pitch/yaw offsets
         produce repeatable chassis disturbances without random terrain. -->
    <model name="bump_1">
      <static>true</static>
      <pose>2 0 0.05 0.1 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>1 4 0.1</size></box></geometry></visual><collision name="collision"><geometry><box><size>1 4 0.1</size></box></geometry></collision></link>
    </model>

    <!-- Opposite roll angle tests recovery after the first lateral disturbance. -->
    <model name="bump_2">
      <static>true</static>
      <pose>3 0 0.05 -0.15 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>1 4 0.1</size></box></geometry></visual><collision name="collision"><geometry><box><size>1 4 0.1</size></box></geometry></collision></link>
    </model>

    <!-- Longer, slightly pitched platform creates a sustained uneven section. -->
    <model name="bump_3">
      <static>true</static>
      <pose>4.5 0 0.08 0 0.05 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>2 4 0.1</size></box></geometry></visual><collision name="collision"><geometry><box><size>2 4 0.1</size></box></geometry></collision></link>
    </model>

    <!-- Final rotated bump excites combined roll/yaw effects later in the path. -->
    <model name="bump_4">
      <static>true</static>
      <pose>6.5 0 0.04 0.1 0 0.5</pose>
      <link name="link"><visual name="visual"><geometry><box><size>1.5 5 0.1</size></box></geometry></visual><collision name="collision"><geometry><box><size>1.5 5 0.1</size></box></geometry></collision></link>
    </model>
  </world>
</sdf>
