<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Robustness world for evaluating tracking under a sustained 15-degree slope. -->
  <world name="incline_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- A large static box is pitched by -0.2617 rad (approximately -15 deg).
         Its dimensions place the top surface across the robot's forward path. -->
    <model name="test_ramp">
      <static>true</static>
      <pose>10 0 -2.0 0 -0.2617 0</pose>
      <link name="ramp_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 10 5</size>
            </box>
          </geometry>
          <!-- Higher friction prevents the ramp test from becoming a pure
               wheel-slip test; low-friction behavior should use a separate map. -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 10 5</size>
            </box>
          </geometry>
          <!-- Visual material affects rendering only, not contact physics. -->
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
